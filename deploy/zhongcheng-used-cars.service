[Unit]
Description=Zhongcheng Used Cars Next.js
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=zhongcheng
Group=zhongcheng
WorkingDirectory=/var/www/zhongcheng-used-cars/.next/standalone
EnvironmentFile=/etc/zhongcheng-used-cars.env
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhongcheng/uploads /var/www/zhongcheng-used-cars/.next/standalone/.next/cache
MemoryMax=850M

[Install]
WantedBy=multi-user.target
