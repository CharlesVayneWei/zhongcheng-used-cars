# 仅由 Next.js 服务端读取，严禁改成 NEXT_PUBLIC_DATABASE_URL。
DATABASE_URL=postgresql://zhongcheng_app:replace-with-a-strong-password@127.0.0.1:5432/zhongcheng_db
# 2 GB 服务器默认保持小连接池。
DB_POOL_MAX=4
# 生产固定为服务器外部目录；开发时可改成项目外的临时目录。
UPLOAD_DIR=/var/lib/zhongcheng/uploads
# 本地界面预览可临时设为 true；生产必须为 false。
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# `pnpm admin:create` 临时读取；创建成功后从环境中删除密码。
ADMIN_LOGIN_NAME=weiling
ADMIN_PASSWORD=replace-with-a-Strong-password-123
ADMIN_DISPLAY_NAME=店主
# 可选，默认 12；取值限制为 10-14。
PASSWORD_BCRYPT_ROUNDS=12
# 可选，默认 12 小时。
ADMIN_SESSION_HOURS=12
# 可选，一次性重置令牌有效分钟数，默认 30。
PASSWORD_RESET_MINUTES=30
