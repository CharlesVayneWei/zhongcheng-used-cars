NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 仅管理员初始化脚本或受控运维任务使用，绝不能以 NEXT_PUBLIC_ 开头。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 本地界面预览可临时设为 true；生产必须为 false。
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# `pnpm admin:create` 临时读取；创建成功后从环境中删除密码。
ADMIN_EMAIL=owner@example.com
ADMIN_LOGIN_NAME=weiling
ADMIN_PASSWORD=Weiling987100
ADMIN_DISPLAY_NAME=店主

# 找回口令和密码加密密钥仅在服务端使用。正式上线前应更换默认口令。
ADMIN_RECOVERY_CODE=858607
ADMIN_RECOVERY_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
