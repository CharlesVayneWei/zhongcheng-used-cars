{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhongcheng-used-cars",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "NEXT_PUBLIC_DEMO_MODE": "true",
    "NEXT_PUBLIC_SITE_URL": "https://zhongcheng-used-cars.charles-vayne-wei.workers.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
